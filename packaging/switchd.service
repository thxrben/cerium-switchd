[Unit]
Description=cerOS switch daemon (switchd)
Documentation=file:///usr/share/doc/switchd/config-reference.md
Before=network-pre.target
Wants=network-pre.target
# Never give up restarting: a switch without switchd has no control plane.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/local/sbin/switchd $SWITCHD_ARGS
# The stack's management address must never outlive switchd on this member
# (after a crash another member takes it over).
ExecStopPost=-/usr/sbin/ip link del cme
EnvironmentFile=-/etc/default/switchd
Restart=always
RestartSec=1
RuntimeDirectory=switchd
RuntimeDirectoryPreserve=yes
StateDirectory=switchd
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
